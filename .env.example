# Copie para .env.local (local) ou cadastre na Vercel (Settings > Environment Variables).
# Deixe vazio enquanto a integração não estiver definida.

# Número do WhatsApp com DDI e DDD, só dígitos. Ex.: 5584XXXXXXXXX
VITE_WHATSAPP_NUMBER=

# Endpoint que receberá os leads do formulário (POST JSON). Ex.: webhook do seu CRM, Make, Zapier ou API própria.
VITE_LEAD_ENDPOINT=

# URL pública do site (usada no canonical e Open Graph).
VITE_SITE_URL=https://potiguar-solar.vercel.app
